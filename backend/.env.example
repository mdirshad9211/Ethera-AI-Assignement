# Runtime — use `development` locally; use `production` behind your reverse proxy.
NODE_ENV=development
PORT=4000

# MongoDB — local:
# MONGODB_URI=mongodb://127.0.0.1:27017/projecthub
# MongoDB Atlas (TLS):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/projecthub?retryWrites=true&w=majority
MONGODB_URI=

# Auth — use a long random secret in production (openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS — comma-separated browser origins (required in production for browser clients)
# Example: https://app.example.com,https://www.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Behind nginx / a load balancer — set true so rate limiting and IPs are correct
TRUST_PROXY=false

# Optional: bootstrap first admin (login uses email + password — there is no separate username).
# User is created only if ADMIN_EMAIL is not already registered. Does not change existing passwords.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-8-chars
ADMIN_NAME=Administrator

# Optional: extra platform admins by email (comma-separated). Same privileges as bootstrap ADMIN_EMAIL for directory users (create accounts without a project).
# PLATFORM_ADMIN_EMAILS=ops@example.com,superuser@example.com
